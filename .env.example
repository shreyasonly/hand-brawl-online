# ---------------------------------------------------------------------------
# HAND BRAWL - Supabase Realtime credentials
# ---------------------------------------------------------------------------
# Local dev : copy this file to `.env.local` and fill in the real values.
# Vercel    : add the same two variables under
#             Project Settings -> Environment Variables.
#
# Both values are PUBLIC browser keys (the anon key is safe to ship in a
# client bundle - it is protected by Supabase Row Level Security).
# NEVER put the service_role key here or anywhere in this repo.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
