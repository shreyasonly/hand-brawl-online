# ---------------------------------------------------------------------------
# HAND BRAWL - environment variables
# ---------------------------------------------------------------------------
# Local dev : you usually need NOTHING - the client auto-connects to
#             ws://<page-hostname>:2567 while `npm run dev:server` is running.
#             Copy this file to `.env.local` only if you want to override that.
# Vercel    : add VITE_GAME_SERVER_URL under
#             Project Settings -> Environment Variables (Production + Preview),
#             pointing at your deployed Colyseus server, then redeploy.
# ---------------------------------------------------------------------------

# The Colyseus game server. ws:// locally, wss:// in production.
VITE_GAME_SERVER_URL=ws://localhost:2567
# Production example:
# VITE_GAME_SERVER_URL=wss://hand-brawl-server.onrender.com

# ---------------------------------------------------------------------------
# LEGACY (no longer used by the game): the old Supabase Realtime netcode.
# Kept only so old .env.local files don't look mysterious.
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
